[Unit]
Description=Run Soc Thief approved triage after the daily report boundary

[Timer]
# The 08:00 boundary closes only after the runner's 15-minute lateness margin.
# The zone must equal SOC_THIEF_TIMEZONE so the run follows the local 08:00 boundary.
OnCalendar=*-*-* 08:20:00 UTC
Persistent=true
RandomizedDelaySec=5m
Unit=soc-thief-runner.service

[Install]
WantedBy=timers.target
