[Unit]
Description=Back up Soc Thief metadata state
After=soc-thief.service
ConditionPathIsMountPoint=/var/backups/soc-thief

[Service]
Type=oneshot
User=soc-thief
Group=soc-thief
ExecStart=/opt/soc-thief/deploy/bin/soc-thief-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/backups/soc-thief
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soc-thief-backup
TimeoutStartSec=90s
TimeoutStopSec=15s
