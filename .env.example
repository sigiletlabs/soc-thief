# Use file paths in deployed environments. Values below are safe placeholders only.
WAZUH_INDEXER_URL_FILE=/run/secrets/wazuh_indexer_url
WAZUH_INDEXER_USERNAME_FILE=/run/secrets/wazuh_indexer_username
WAZUH_INDEXER_PASSWORD_FILE=/run/secrets/wazuh_indexer_password
# The hardened systemd deployment mounts an explicit private CA bundle.
WAZUH_INDEXER_CA_FILE=/run/secrets/wazuh_indexer_ca
DISCORD_WEBHOOK_URL_FILE=/run/secrets/discord_webhook_url
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen3:4b
# Bound one non-streaming local review; failures require delivery and health review.
MODEL_TIMEOUT_SECONDS=60
# Model backend: ollama (default, the MODEL_* settings above), openai (any OpenAI-compatible
# chat-completions API: LM Studio, llama.cpp, vLLM, Ollama's /v1, OpenRouter...) or jev.
# The model only advises; it can never stop a group being delivered.
# SOC_THIEF_MODEL_BACKEND=openai
# SOC_THIEF_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# SOC_THIEF_OPENAI_MODEL=qwen3-4b
# Optional bearer key, read from a file only.
# SOC_THIEF_OPENAI_API_KEY_FILE=/run/secrets/openai_key
# SOC_THIEF_OPENAI_TIMEOUT_SECONDS=60
# A non-loopback base URL is refused unless this is 1, acknowledging that minimised,
# pseudonymised alert summaries leave this host; it must then be https.
# SOC_THIEF_OPENAI_ALLOW_REMOTE=1
# Report timezone, an IANA name (default UTC). The report day runs 08:00 to 08:00 in this zone and
# every local time in reports and pages uses it. Keep the systemd timers' OnCalendar zone equal.
SOC_THIEF_TIMEZONE=UTC
# Optional: remote management (RMM) tools trusted on these hosts, comma-separated names or
# process/path markers. A breach follow-up then asks whether the alerts fit that tool. Advice only.
# SOC_THIEF_RMM_MARKERS=ExampleRMM Agent,C:\Program Files\ExampleRMM\agent.exe
# A private 0700 directory; its parent must already exist and be operator-controlled.
STATE_PATH=/var/lib/soc-thief/state
# One line of 64 lowercase hex characters (32 bytes); stable for the life of the state store.
SOC_THIEF_IDENTITY_KEY_FILE=/run/secrets/identity_key
# Single-line JSON: {"approved_route":"daily-digest","expires":"<UTC ISO, at most 30 days ahead>"}
# or {"approved_route":"daily-digest","expires":"never"} for a standing approval. Deleting the
# file stops every run, health reports and pages included.
SOC_THIEF_RUNNER_APPROVAL_FILE=/run/secrets/runner_approval

# Run bounded delivery verification against a new webhook before enabling the daily runner.
MODE=verify
